{% extends "layout.njk" %}
{% import "_macros.njk" as m with context %}
{% block content %}
<p><a href="{{ back }}">← Zurück</a></p>
<h1>Termin am {{ booking.starts_at | dateTime }}</h1>
<div class="card">
  <dl>
    <dt>Leistung</dt><dd>{{ booking.service.name }}</dd>
    <dt>Zeit</dt><dd>{{ booking.starts_at | dateTime }} bis {{ booking.ends_at | time }}</dd>
    <dt>Ärztin / Arzt</dt><dd>{% if booking.doctor %}{{ booking.doctor.first_name }} {{ booking.doctor.last_name }}{% else %}<span class="muted">noch nicht zugeordnet</span>{% endif %}</dd>
    {% if booking.patient %}
    <dt>Patient:in</dt><dd>{{ booking.patient.first_name }} {{ booking.patient.last_name }}{% if booking.patient.email %} · {{ booking.patient.email }}{% endif %}{% if booking.patient.phone %} · {{ booking.patient.phone }}{% endif %}</dd>
    {% endif %}
    <dt>Status</dt><dd><span class="badge">{{ statusLabels[booking.status] }}</span></dd>
    <dt>Grund</dt><dd>{{ booking.reason or '–' }}</dd>
    <dt>Anmerkung</dt><dd>{{ booking.info or '–' }}</dd>
  </dl>
  {% if upcoming %}
  <form method="post" action="/bookings/{{ booking.id }}/cancel">{{ m.csrf() }}<button type="submit" class="danger">Termin stornieren</button></form>
  {% else %}<p class="muted">Dieser Termin liegt in der Vergangenheit und kann nicht mehr geändert werden.</p>{% endif %}
</div>

{% if staff and upcoming %}
<section class="card" aria-labelledby="h-edit">
  <h2 id="h-edit">Bearbeiten</h2>
  <form method="post" action="/bookings/{{ booking.id }}/edit">
    {{ m.csrf() }}
    {{ m.field('reason', 'Grund', {value: booking.reason, maxlength: 200}) }}
    {{ m.field('info', 'Anmerkung', {value: booking.info, textarea: true, rows: 3, maxlength: 2000}) }}
    <button type="submit">Speichern</button>
  </form>
  <p><a class="button secondary" href="/bookings/{{ booking.id }}/reschedule">Termin verschieben</a></p>
</section>
<section class="card" aria-labelledby="h-assign">
  <h2 id="h-assign">Ärztin / Arzt zuordnen</h2>
  <form method="post" action="/bookings/{{ booking.id }}/assign" class="narrow">
    {{ m.csrf() }}
    <div class="field">
      <label for="f-doctor_id">Ärztin / Arzt</label>
      <select id="f-doctor_id" name="doctor_id" required>
        <option value="">Bitte wählen</option>
        {% for d in doctors %}<option value="{{ d.id }}"{% if booking.doctor and booking.doctor.id == d.id %} selected{% endif %}>{{ d.first_name }} {{ d.last_name }}{% if d.specialties.length %} ({% for sp in d.specialties %}{{ sp.name }}{% if not loop.last %}, {% endif %}{% endfor %}){% endif %}</option>{% endfor %}
      </select>
    </div>
    <button type="submit">Zuordnen</button>
  </form>
</section>
{% endif %}
{% endblock %}
