{% extends "layout.njk" %}
{% import "_macros.njk" as m with context %}
{% block content %}
<h1>Aufbewahrungsfristen</h1>
<p class="muted">Nach dem Löschkonzept: Termine werden zuerst gesperrt (Soft Delete) und nach diesen Fristen endgültig gelöscht. Frist C darf nicht kürzer sein als Frist B.</p>
{% if error %}<p class="alert" role="alert">{{ error }}</p>{% endif %}
<form method="post" action="/admin/retention" class="retention">
  {{ m.csrf() }}
  {{ m.field('retention_a_days', 'A: stornierter Termin bis zur endgültigen Löschung (Tage)', {type: 'number', value: v.retention_a_days, required: true, min: 1, max: 3650, errors: errors}) }}
  {{ m.field('retention_b_days', 'B: abgeschlossener Termin, Grund und Anmerkung löschen nach (Tage)', {type: 'number', value: v.retention_b_days, required: true, min: 1, max: 3650, errors: errors}) }}
  {{ m.field('retention_c_days', 'C: abgeschlossener Termin endgültig löschen nach (Tage)', {type: 'number', value: v.retention_c_days, required: true, min: 1, max: 3650, errors: errors}) }}
  {{ m.field('retention_d_days', 'D: gelöschtes Konto endgültig löschen nach (Tage)', {type: 'number', value: v.retention_d_days, required: true, min: 1, max: 3650, errors: errors}) }}
  {{ m.field('retention_e_days', 'E: Protokolleinträge löschen nach (Tage)', {type: 'number', value: v.retention_e_days, required: true, min: 1, max: 3650, errors: errors}) }}
  <button type="submit">Speichern</button>
</form>
{% endblock %}
