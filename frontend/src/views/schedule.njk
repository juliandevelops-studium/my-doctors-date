{% extends "layout.njk" %}
{% import "_macros.njk" as m with context %}
{% block content %}
<p><a href="/practice">← Zurück</a></p>
<h1>Arbeitszeiten: {{ doctor.first_name }} {{ doctor.last_name }}</h1>
<form method="post" action="/practice/doctors/{{ doctor.id }}" class="card">
  {{ m.csrf() }}
  <fieldset>
    <legend>Fachrichtungen</legend>
    {% for s in specialties %}
      <label><input type="checkbox" name="specialty" value="{{ s.id }}"{% if s.id in selected %} checked{% endif %}> {{ s.name }}</label>
    {% else %}<p class="muted">Legen Sie zuerst Fachrichtungen an.</p>{% endfor %}
  </fieldset>
  <fieldset>
    <legend>Arbeitszeiten (bis zu drei Blöcke pro Tag, Zeit der Praxis)</legend>
    <div class="table-wrap keep"><table>
      <thead><tr><th>Tag</th><th>Block 1</th><th>Block 2</th><th>Block 3</th></tr></thead>
      <tbody>
      {% for r in rows %}
        <tr><th scope="row">{{ r.label }}</th>
        {% for b in r.blocks %}
          <td>
            <label class="muted" for="{{ r.key }}_from{{ loop.index }}">von</label>
            <input type="time" id="{{ r.key }}_from{{ loop.index }}" name="{{ r.key }}_from{{ loop.index }}" value="{{ b.from }}">
            <label class="muted" for="{{ r.key }}_to{{ loop.index }}">bis</label>
            <input type="time" id="{{ r.key }}_to{{ loop.index }}" name="{{ r.key }}_to{{ loop.index }}" value="{{ b.to }}">
          </td>
        {% endfor %}
        </tr>
      {% endfor %}
      </tbody>
    </table></div>
  </fieldset>
  <button type="submit">Speichern</button>
</form>
{% endblock %}
