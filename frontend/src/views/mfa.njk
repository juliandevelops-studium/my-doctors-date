{% extends "layout.njk" %}
{% import "_macros.njk" as m with context %}
{% block content %}
<h1>Zwei-Faktor-Anmeldung</h1>
<form method="post" action="/login/mfa" class="card narrow">
  {{ m.csrf() }}
  {% if recovery %}
    <input type="hidden" name="mode" value="recovery">
    {{ m.field('recovery_code', 'Recovery-Code', {required: true, autocomplete: 'one-time-code', autofocus: true, maxlength: 32, hint: 'Jeder Recovery-Code funktioniert nur einmal.'}) }}
  {% else %}
    <input type="hidden" name="mode" value="code">
    {{ m.field('code', 'Code aus der Authenticator-App', {required: true, autocomplete: 'one-time-code', inputmode: 'numeric', pattern: '[0-9]{6}', maxlength: 6, autofocus: true, hint: 'Sechs Ziffern.'}) }}
  {% endif %}
  <button type="submit">Anmelden</button>
</form>
<ul class="plain">
  {% if recovery %}<li><a href="/login/mfa">Stattdessen den Code der App verwenden</a></li>
  {% else %}<li><a href="/login/mfa?recovery=1">Gerät verloren? Recovery-Code verwenden</a></li>{% endif %}
</ul>
<form method="post" action="/login/mfa" class="inline-note">
  {{ m.csrf() }}
  <input type="hidden" name="mode" value="none">
  <p>Noch keine Zwei-Faktor-Anmeldung eingerichtet (erste Anmeldung)?
  <button type="submit" class="link">Weiter ohne Code zur Einrichtung</button></p>
</form>
{% endblock %}
