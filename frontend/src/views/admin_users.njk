{% extends "layout.njk" %}
{% import "_macros.njk" as m with context %}
{% block content %}
<h1>Benutzer</h1>
<form method="get" action="/admin/users" class="filters">
  {{ m.field('q', 'Name oder E-Mail', {value: q, maxlength: 100}) }}
  <div class="field"><label for="f-role">Rolle</label><select id="f-role" name="role"><option value="">alle</option>
    {% for r in roles %}<option value="{{ r }}"{% if r == role %} selected{% endif %}>{{ roleLabels[r] }}</option>{% endfor %}</select></div>
  <div class="field"><label for="f-status">Status</label><select id="f-status" name="status"><option value="">alle</option>
    {% for s in statuses %}<option value="{{ s }}"{% if s == statusFilter %} selected{% endif %}>{{ statusLabels[s] }}</option>{% endfor %}</select></div>
  <button type="submit" class="secondary">Filtern</button>
</form>
<div class="table-wrap"><table>
  <thead><tr><th>Name</th><th>E-Mail</th><th>Rollen</th><th>Status</th></tr></thead>
  <tbody>
  {% for u in items %}
    <tr><td data-label="Name"><a href="/admin/users/{{ u.id }}">{{ u.first_name }} {{ u.last_name }}</a></td><td data-label="E-Mail">{{ u.email }}</td>
      <td data-label="Rollen">{% for r in u.roles %}<span class="badge">{{ roleLabels[r] }}</span> {% endfor %}</td>
      <td data-label="Status"><span class="badge {% if u.status == 'active' %}ok{% elif u.status == 'locked' or u.permanently_locked %}bad{% else %}warn{% endif %}">{{ statusLabels[u.status] }}</span>{% if u.permanently_locked %} <span class="badge bad">dauerhaft gesperrt</span>{% elif u.locked_until %} <span class="badge warn">zeitweise gesperrt</span>{% endif %}</td></tr>
  {% endfor %}
  </tbody>
</table></div>
{{ m.pager(pagerBase, total, limit, offset) }}

<section class="card" aria-labelledby="h-new">
  <h2 id="h-new">Benutzer anlegen</h2>
  <p class="muted">Die Person erhält einen Link, um ihr Passwort festzulegen. Sie sehen kein Passwort. „Systemadministration“ kann nicht mit anderen Rollen kombiniert werden.</p>
  {% if error %}<p class="alert" role="alert">{{ error }}</p>{% endif %}
  <form method="post" action="/admin/users">
    {{ m.csrf() }}
    <div class="grid2">
      {{ m.field('first_name', 'Vorname', {value: v.first_name if v, required: true, maxlength: 100, errors: errors}) }}
      {{ m.field('last_name', 'Nachname', {value: v.last_name if v, required: true, maxlength: 100, errors: errors}) }}
    </div>
    {{ m.field('email', 'E-Mail-Adresse', {type: 'email', value: v.email if v, required: true, maxlength: 254, errors: errors}) }}
    <fieldset><legend>Rollen</legend>
      {% for r in roles %}<label><input type="checkbox" name="roles" value="{{ r }}"{% if v and r in v.roles %} checked{% endif %}> {{ roleLabels[r] }}</label>{% endfor %}
    </fieldset>
    <button type="submit">Anlegen</button>
  </form>
</section>
{% endblock %}
