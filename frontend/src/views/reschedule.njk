{% extends "layout.njk" %}
{% import "_macros.njk" as m with context %}
{% block content %}
<p><a href="/bookings/{{ booking.id }}">← Zurück zum Termin</a></p>
<h1>Termin verschieben</h1>
<p>{{ booking.service.name }}, bisher {{ booking.starts_at | dateTime }}{% if booking.doctor %} bei {{ booking.doctor.first_name }} {{ booking.doctor.last_name }}{% endif %}.</p>
<nav class="pager" aria-label="Woche wählen">
  {% if range.prev %}<a href="/bookings/{{ booking.id }}/reschedule?from={{ range.prev }}">← Vorige Woche</a>{% else %}<span class="off" aria-disabled="true">← Vorige Woche</span>{% endif %}
  <span>ab {{ range.from }}</span>
  <a href="/bookings/{{ booking.id }}/reschedule?from={{ range.next }}">Nächste Woche →</a>
</nav>
<form method="post" action="{{ action }}" class="card">
  {{ m.csrf() }}
  <input type="hidden" name="from" value="{{ range.from }}">
  {% if days.length == 0 %}<p class="muted">In dieser Woche sind keine Termine frei.</p>{% endif %}
  {% for d in days %}
  <section class="day"><h3>{{ d.label }}</h3>
    <div class="slots">{% for s in d.items %}<button type="submit" name="starts_at" value="{{ s.starts_at }}">{{ s.starts_at | time }}</button>{% endfor %}</div>
  </section>
  {% endfor %}
</form>
{% endblock %}
