{
  "name": "frontend-provider",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Server-side rendered frontend (Express + Nunjucks). No business logic, no authorization decisions: it forwards the token, the backend services decide.",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node src/server.js",
    "lint": "eslint .",
    "test": "node --test --test-reporter=spec \"test/unit/**/*.test.js\" \"test/integration/**/*.test.js\"",
    "test:e2e": "node --test --test-reporter=spec --test-concurrency=1 \"test/e2e/**/*.test.js\""
  },
  "dependencies": {
    "express": "5.3.0",
    "helmet": "8.3.0",
    "nunjucks": "3.2.4",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0"
  }
}
